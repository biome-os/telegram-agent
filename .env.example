# telegram-agent — environment configuration
#
# !! SECRETS DO NOT BELONG HERE !!
# The Telegram bot token and webhook secret must be set through the orchestrator
# dashboard:
#   http://<orchestrator>:8000  →  Agents  →  telegram-agent  →  ⚙ Settings
#   Required:  telegram_bot_token
#   Optional:  telegram_webhook_secret
#
# This file contains only non-secret infrastructure configuration.

# Orchestrator endpoint
ORCHESTRATOR_URL=http://localhost:8000

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Which agent receives incoming Telegram messages (default: task-planner-agent)
TELEGRAM_ROUTING_TARGET=task-planner-agent

# Webhook server bind address (only relevant when using webhook mode, not long-polling)
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# Public HTTPS URL for webhook mode — leave empty to use long-polling instead
# TELEGRAM_WEBHOOK_URL=https://your-domain.com/webhook

# Task routing timeout (seconds)
TASK_TIMEOUT_S=60
